<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>arena_evaluation</name>
  <version>0.0.0</version>
  <description>Offline/online metric engine + BDDL for Arena VLN + social navigation benchmarking.</description>
  <maintainer email="sgt79911030@gmail.com">Junting Chen</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <!-- Optional at runtime, but commonly present in Arena stacks -->
  <exec_depend>arena_people_msgs</exec_depend>
  <exec_depend>python3-pandas</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
